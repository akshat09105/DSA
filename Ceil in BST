/*
Definition for Node
class Node {
  public:
    int data;
    Node* left;
    Node* right;

    Node(int val) {
        data = val;
        left = right = nullptr;
    }
};
*/

class Solution {
  public:
    int findCeil(Node* root, int x) {
        // code her
        int ceil=-1;
        while(root!=nullptr){
            if(root->data>=x){
                ceil=root->data;
                root=root->left;
            }
            else{
                root=root->right;
            }
        }
        return ceil;
    }
};
